{
  "artifact": "qurl-target-path-v1-vectors",
  "schema_version": 1,
  "description": "Shared canonical target_path request grammar for qURL Connector mints.",
  "contract": {
    "wire_field": "target_path",
    "max_bytes": 2048,
    "omitted_semantics": "bare_origin",
    "explicit_empty_semantics": "reject",
    "accepted_character_set": "raw_ascii_canonical_uri_path_and_query",
    "accepted_value_handling": "preserve_exact_bytes",
    "percent_encoding_handling": "reject_all_path_escapes_accept_well_formed_query_escapes_without_normalize_or_decode"
  },
  "cases": [
    {
      "name": "accept_omitted",
      "present": false,
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_root",
      "present": true,
      "value": "/",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_simple_path",
      "present": true,
      "value": "/view/abc123",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_path_query",
      "present": true,
      "value": "/view/abc123?sig=deadBEEF&exp=1700000000",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_allowed_ascii",
      "present": true,
      "value": "/a-b_c.d~e!f$g&h'i(j)k*l+m,n=o:p@q",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_deep_path",
      "present": true,
      "value": "/a/b/c/d/e/f",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_dotdot_substring",
      "present": true,
      "value": "/view/a..b",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_three_dot_segment",
      "present": true,
      "value": "/view/...",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_dotdot_in_query",
      "present": true,
      "value": "/view/x?redir=../../etc",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_authority_text_in_query",
      "present": true,
      "value": "/path?next=//evil.example",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_trailing_slash",
      "present": true,
      "value": "/view/",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_empty_query",
      "present": true,
      "value": "/?",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_percent_only_in_query",
      "present": true,
      "value": "/view/x?sig=a%20b",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_encoded_dot_slash_in_query",
      "present": true,
      "value": "/view/x?next=%2e%2E%2f%2F",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_encoded_controls_in_query",
      "present": true,
      "value": "/view/x?a=%0d%0a%00",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_semicolon_in_query",
      "present": true,
      "value": "/view/abc?x=1;y=2",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "accept_max_bytes",
      "present": true,
      "value": "",
      "outcome": "accept",
      "open_supported": true
    },
    {
      "name": "reject_explicit_empty",
      "present": true,
      "value": "",
      "outcome": "reject",
      "reject_class": "empty"
    },
    {
      "name": "reject_too_long",
      "present": true,
      "value": "",
      "outcome": "reject",
      "reject_class": "too_long"
    },
    {
      "name": "reject_overlong_non_ascii_precedence",
      "present": true,
      "value": "é",
      "outcome": "reject",
      "reject_class": "too_long"
    },
    {
