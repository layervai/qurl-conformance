{
  "name": "@layervai/qurl-conformance",
  "version": "0.14.0",
  "description": "qURL cross-language conformance vectors",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
