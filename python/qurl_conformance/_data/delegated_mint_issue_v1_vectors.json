{
  "artifact": "qurl-delegated-mint-issue-v1-vectors",
  "schema_version": 1,
  "description": "Byte-exact private Connector-to-issuer-service authentication contract for delegated-mint capability issuance. The signature binds the configured issuer identity, exact request body, route, authority, replay nonce, and idempotency key. Capability claims and public redemption remain separate service-owned contracts.",
  "contract": {
    "method": "POST",
    "route": "/internal/v1/delegated-mint-capabilities",
    "signing_domain_ascii": "LV-QURL-CAPABILITY-ISSUE-V1",
    "signing_domain_separator_hex": "00",
    "frame_encoding": "u32be_byte_length_then_exact_utf8_bytes",
    "field_order": [
      "method",
      "authority",
      "route",
      "issuer_id",
      "kid",
      "idempotency_key",
      "timestamp_unix_decimal",
      "nonce",
      "body_sha256"
    ],
    "body_digest": "SHA-256",
    "body_digest_encoding": "lowercase_hex",
    "body_max_bytes": 8192,
    "signature_algorithm": "ECDSA_P-256_SHA-256",
    "signature_encoding": "canonical_der_base64url_unpadded_low_s",
    "public_key_encoding": "der_spki_base64url_unpadded",
    "nonce_encoding": "base64url_unpadded",
    "nonce_decoded_bytes": 16,
    "idempotency_key_pattern": "^[A-Za-z0-9._~-]{1,128}$",
    "idempotency_derivation_domain_ascii": "LV-QURL-CAPABILITY-ISSUE-IDEMPOTENCY-V1",
    "idempotency_derivation": "domain_then_zero_then_u32be_length_prefixed_issuer_id_upload_handle_generation_decimal_sha256_base64url_unpadded",
    "idempotency_key_prefix": "uci_",
    "idempotency_key_min_bytes": 1,
    "idempotency_key_max_bytes": 128,
    "idempotency_key_header": "Idempotency-Key",
    "issuer_field_pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
    "issuer_id_header": "X-LayerV-Issuer-ID",
    "kid_header": "X-LayerV-Issuer-KID",
    "timestamp_header": "X-LayerV-Timestamp",
    "nonce_header": "X-LayerV-Nonce",
    "signature_header": "X-LayerV-Signature",
    "authority_normalization": "lowercase_dns_name_no_port",
    "authority_binding_rule": "receiver_requires_method_route_and_authority_to_equal_its_configured_endpoint",
    "authority_max_bytes": 253,
    "success_status": 200,
    "success_content_type": "application/json",
    "success_envelope": "data",
    "success_data_fields": [
      "capability",
      "capability_expires_at",
      "authority_expires_at"
    ],
    "success_reconciliation_rule": "authority_expiry_equals_immutable_operation_authority_capability_expiry_is_canonical_and_not_after_authority_expired_capability_advances_generation",
    "error_content_type": "application/problem+json",
    "error_envelope": "rfc7807_error_object_plus_meta_request_id_no_unknown_fields",
    "body_authority_fields": [
      "upload_handle",
      "issue_generation",
      "upload_request_digest",
      "content_sha256",
      "byte_size",
      "media_type",
      "display_filename",
      "audience_key_id",
      "target_path",
      "max_batch_size",
      "max_link_ttl_seconds",
      "capability_expires_at",
      "authority_expires_at"
    ],
    "body_semantic_validation_rule": "receiver_strictly_decodes_and_validates_every_body_authority_field_before_state_access_service_policy_owns_runtime_ceilings",
    "external_operation_commit_rule": "uncommitted_external_operation_may_advance_internal_issue_generation_within_same_authority_committed_external_response_replays_byte_exact_new_outward_capability_requires_new_signed_external_request",
    "capability_ttl_seconds": 900,
    "authority_max_ttl_seconds": 86400,
    "timestamp_max_skew_seconds": 300,
    "nonce_replay_retention_seconds": 900,
    "expiry_authority_rule": "caller_supplies_signed_values_service_requires_capability_timestamp_plus_900_and_initial_authority_at_most_timestamp_plus_86400_refresh_preserves_authority",
    "exact_replay_freshness_rule": "verify_shape_signature_then_operation_lookup_before_freshness_exact_accepted_envelope_returns_original_same_operation_authority_fresh_envelope_reconciles_changed_authority_conflicts_stale_nonexact_rejects_without_mutation",
    "operation_identity_fields": [
      "issuer_id",
      "upload_handle",
      "issue_generation",
      "idempotency_key"
    ],
    "authority_fingerprint_fields": [
      "upload_request_digest",
      "content_sha256",
      "byte_size",
      "media_type",
      "display_filename",
      "audience_key_id",
      "target_path",
      "max_batch_size",
      "max_link_ttl_seconds",
      "authority_expires_at",
      "service_owned_issuer_policy_fingerprint"
    ],
    "envelope_fingerprint_fields": [
      "method",
      "authority",
      "route",
      "issuer_id",
      "kid",
      "idempotency_key",
      "timestamp_unix_decimal",
      "nonce",
      "exact_body_sha256",
      "signature_der_b64url"
    ],
    "transport_replay_rule": "exact_accepted_envelope_may_bypass_freshness_same_operation_authority_different_envelope_requires_fresh_timestamp_and_nonce_binding_issuer_kid_may_rotate",
    "stale_operation_miss_rule": "authenticated_strongly_consistent_absent_stale_operation_returns_no_mutation_connector_retries_fresh_same_generation",
    "stale_operation_miss_status": 404,
    "stale_operation_miss_code": "issue_operation_not_found",
    "issuer_key_retention_rule": "accepted_kid_verifier_retained_until_operation_authority_expires",
    "expiry_encoding": "rfc3339_utc_second_precision_literal_Z",
    "reject_classes": [
      "authority",
      "body_size",
      "idempotency_key",
      "nonce",
      "signature_encoding",
      "signature_malleability",
      "signature_scalar",
      "signature_mismatch"
    ],
    "state_outcomes": [
      "issue_new",
      "return_durable_result",
      "reject"
    ],
    "state_mutations": [
      "store_operation_and_bind_nonce",
      "bind_nonce_to_existing_operation",
      "none"
    ],
    "retry_after_modes": [
      "absent",
      "exact_seconds",
      "positive_integer_seconds"
    ]
  },
